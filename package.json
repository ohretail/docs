{
  "name": "ohretail-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "hugo server --buildDrafts",
    "build": "hugo --gc --minify --panicOnWarning",
    "check": "npm run build && node scripts/check-links.mjs public",
    "preview": "npm run build && wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
